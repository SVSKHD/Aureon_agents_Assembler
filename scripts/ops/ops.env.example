# Copy to scripts/ops/ops.env (git-ignored) to override the defaults in scripts/ops/lib.sh.
# No secrets here: Postgres is reached inside its own container over the local socket.

# Existing Postgres: EITHER its compose project + service ...
PG_COMPOSE_DIR=/opt/private-ai
PG_SERVICE=postgres
# ... OR its container name (then `docker exec -i` is used instead of compose exec -T).
# PG_CONTAINER=<postgres-container>
PG_USER=postgres
PG_DB=spasta

DATA_ROOT=/mnt/spasta-data
BACKUP_DIR=/mnt/spasta-data/backups/aureon
BACKUP_RETENTION_DAYS=14
BACKUP_DATA_DIRS="images finance-attachments"
BACKUP_PUBLIC_FUNCTIONS=astra_uid
