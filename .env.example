# Copy to .env (never commit .env). All values below are placeholders.

# dev | test | prod. In prod the API refuses to start unless the checklist in
# docs/16-production-hardening.md passes (HDD marker, strong SECRET_KEY, COOKIE_SECURE=true,
# no DEBUG, no API docs, no "*" CORS origin, LIVE off unless PHASE_G_APPROVED=yes).
ENV=prod
LOG_LEVEL=INFO
# Both refused in prod. API docs default to on outside prod, off in prod.
DEBUG=false
# API_DOCS_ENABLED=
# Seconds the migrate one-shot waits for Postgres at `docker compose up` (then upgrade head).
MIGRATE_WAIT_SECONDS=180

# Existing Postgres container, reached over the private Docker network by CONTAINER NAME.
# Replace <postgres-container> and credentials with values from docs/00-inspection.md.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<postgres-container>:5432/spasta
# Phase 22 (docs/24): with the scoped roles, DATABASE_URL uses aureon_app and the migrator's
# URL goes in a separate .env.migrate (read only by the `migrate` one-shot), NOT here:
#   MIGRATIONS_DATABASE_URL=postgresql+asyncpg://aureon_migrator:<pw>@<postgres-container>:5432/spasta

# Redis started by this compose file (container name aureon-redis, network "aureon").
REDIS_URL=redis://aureon-redis:6379/0

# Existing Ollama container on the private-ai network (do not use localhost).
OLLAMA_BASE_URL=http://<ollama-container>:11434

# Existing Stable Diffusion pipeline on the host (used from Phase 4).
IMAGE_AGENT_PATH=/opt/image-agent

# 2 TB HDD mount. DATA_ROOT_MARKER must exist on the HDD itself:
#   touch /mnt/spasta-data/.spasta-data-mounted   (run once, while the HDD is mounted)
DATA_ROOT=/mnt/spasta-data
DATA_ROOT_MARKER=.spasta-data-mounted

# >= 32 chars, random. Prod refuses this placeholder and low-entropy keys.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars

# Comma-separated allowlist of browser origins.
CORS_ORIGINS=http://192.168.29.95:8088,https://spasta.online

# Seconds per dependency in GET /api/health/ready
HEALTH_CHECK_TIMEOUT=3

# --- auth ---
SESSION_TTL_HOURS=12
# Keep true in prod (cookies get the __Host- prefix). Set false ONLY for plain-http LAN dev;
# browsers drop Secure cookies on http://192.168.29.95:8088.
COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_SECONDS=900
# Proxy IPs whose X-Forwarded-For is trusted: the Docker bridge gateway Nginx connects from,
# e.g. 172.18.0.1 (docker network inspect aureon -f '{{(index .IPAM.Config 0).Gateway}}').
FORWARDED_ALLOW_IPS=127.0.0.1

# --- ollama / chat (docs/03-ollama.md) ---
OLLAMA_MAX_CONCURRENT=1
OLLAMA_MAX_QUEUE=3
OLLAMA_QUEUE_RETRY_AFTER=15
OLLAMA_CONNECT_TIMEOUT=5
# Longest allowed silence between streamed chunks (cold model load on CPU).
OLLAMA_READ_TIMEOUT=300
OLLAMA_MODEL_CACHE_SECONDS=60
CHAT_TIMEOUT_SECONDS=900
CHAT_HEARTBEAT_SECONDS=15
CHAT_DEFAULT_NUM_CTX=4096
CHAT_MAX_NUM_CTX=8192
# CPU tuning (docs/03-ollama.md, "Speed on a CPU-only box"). The default model is listed
# first by GET /api/models (the SPA preselects it) and loaded at API start (CHAT_WARMUP).
CHAT_DEFAULT_MODEL=
CHAT_WARMUP=true
# Ollama num_thread per generation; 0 = Ollama decides.
CHAT_NUM_THREAD=0
# Stored turns re-sent per request (system messages always); 0 = the whole conversation.
CHAT_HISTORY_MAX_MESSAGES=0
# Ollama keep_alive for API chats ("24h", "30m", "-1" = forever); empty = Ollama's default.
OLLAMA_KEEP_ALIVE=

# --- imaging (docs/04-imaging.md) ---
# subprocess = run the existing /opt/image-agent entrypoint; stub = placeholder PNGs (dev only)
IMAGE_GENERATOR=subprocess
# JSON argv template, run WITHOUT a shell. Fill from docs/00-inspection.md §5. Example only:
IMAGE_AGENT_COMMAND=["python", "/opt/image-agent/generate.py", "--prompt", "{prompt}", "--negative", "{negative_prompt}", "--seed", "{seed}", "--steps", "{steps}", "--width", "{width}", "--height", "{height}", "--output", "{output}"]
# Requirements file inside IMAGE_AGENT_PATH used to build the imaging worker image.
IMAGE_AGENT_REQUIREMENTS=requirements.txt
# Env var names copied into the entrypoint (e.g. HF_HOME). Secrets are never passed.
IMAGE_AGENT_ENV_PASSTHROUGH=
IMAGE_THREADS=3
IMAGE_MODEL_NAME=sd-1.5
IMAGE_ALLOWED_SIZES=512x512,512x768,768x512
IMAGE_DEFAULT_STEPS=25
IMAGE_MAX_STEPS=50
IMAGE_QUEUE_MAX=5
IMAGE_RETRY_AFTER=600
IMAGE_JOB_TIMEOUT_SECONDS=1800
IMAGE_MAX_ATTEMPTS=2
IMAGE_POLL_SECONDS=2

# --- agents / scheduler / monitoring (docs/05-agents.md) ---
AGENT_HEARTBEAT_SECONDS=15
AGENT_STALE_SECONDS=60
AGENT_LOG_RETENTION_DAYS=30
AGENT_RUN_RETENTION_DAYS=90
SCHEDULER_TICK_SECONDS=5
SCHEDULER_TIMEZONE=Asia/Kolkata
# Read-only Docker socket proxy from compose.yaml; empty disables the docker section.
DOCKER_API_URL=http://aureon-docker-proxy:2375
# Written by deploy/host-status (systemd timer on the host).
HOST_STATUS_FILE=/mnt/spasta-data/status/host-services.json
HOST_STATUS_MAX_AGE_SECONDS=120

# --- trading (docs/10-trading-foundation.md) ---
# LIVE execution feature flag. Keep false; even when true, LIVE needs Phase G preconditions.
TRADING_LIVE_ENABLED=false
# Owner's Phase G sign-off. TRADING_LIVE_ENABLED=true is refused at startup unless this is "yes".
PHASE_G_APPROVED=
TRADING_LIVE_TOKEN_TTL_SECONDS=300
TRADING_ADAPTER_TIMEOUT=10

# --- Dhan (docs/11-dhan.md). Env only: never commit real values. ---
# DHAN_CLIENT_ID=1100000000
# DHAN_ACCESS_TOKEN=<24 h token from web.dhan.co → DhanHQ Trading APIs>
DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_FEED_URL=wss://api-feed.dhan.co
DHAN_INSTRUMENT_CSV_URL=https://images.dhan.co/api-data/api-scrip-master-detailed.csv
DHAN_HTTP_TIMEOUT=15
DHAN_TOKEN_WARN_HOURS=4
# Live feed worker: SEGMENT:SECURITY_ID list (IDX_I:13 = NIFTY 50, IDX_I:25 = BANKNIFTY)
DHAN_FEED_INSTRUMENTS=IDX_I:13
DHAN_FEED_MODE=quote
DHAN_FEED_QUEUE_MAX=10000
DHAN_FEED_STALE_SECONDS=60
DHAN_FEED_MAX_BACKOFF_SECONDS=60
# Scheduled jobs (IST cron; created only when DHAN_CLIENT_ID + DHAN_ACCESS_TOKEN are set)
DHAN_INSTRUMENTS_CRON=11 8 * * 1-5
DHAN_RECONCILE_CRON=*/5 9-15 * * 1-5
DHAN_BACKFILL_CRON=41 16 * * 1-5
DHAN_BACKFILL_INSTRUMENTS=
DHAN_BACKFILL_TIMEFRAMES=1d,15m
DHAN_BACKFILL_DAYS=30
# The static IP you whitelisted on Dhan; only scripts/dhan_preflight.py reads it.
# DHAN_STATIC_IP=

# --- MT5 bot (docs/12-mt5-adapter.md). Read-only: Aureon only reads the bot's status export. ---
# EITHER the bot's logs/status.json as seen inside the containers (read-only mount) ...
# MT5_STATUS_FILE=/mnt/mt5-bot/status.json
# ... OR its GET /status over Tailscale, with the bot's AUREON_STATUS_TOKEN (never its console token).
# MT5_STATUS_URL=https://aureon-box.tail1234.ts.net:8788/status
# MT5_STATUS_TOKEN=
MT5_HTTP_TIMEOUT=5
# The bot shows as stale when its export is older than this.
MT5_STALE_SECONDS=90
# MT5 login / server / deposit currency of the account the bot trades (positions + mt5.terminals).
# MT5_ACCOUNT_ID=
# MT5_SERVER=
MT5_ACCOUNT_CURRENCY=USD
MT5_SYNC_CRON=* * * * *

# --- research agents (docs/13-research-agents.md). Deterministic; the LLM only explains. ---
RESEARCH_TICK_SECONDS=60
RESEARCH_QUEUE_MAX=200
RESEARCH_LOOKBACK_BARS=500
RESEARCH_EMA_PERIODS=9,21
RESEARCH_BACKFILL_DAYS=10
RESEARCH_STALE_BARS=3
# Risk assumptions (basis points per side) and freshness limits.
RISK_SPREAD_BPS=2
RISK_SLIPPAGE_BPS=2
RISK_FEE_BPS=3
RISK_MAX_COST_BPS=25
RISK_ACCOUNT_STALE_SECONDS=900
RISK_SIGNAL_MAX_AGE_BARS=2
BACKTEST_MAX_GRID=50
BACKTEST_MAX_BARS=200000
# Local Ollama model for explanations (e.g. one from GET /api/models); empty = explanations off.
RESEARCH_AI_MODEL=
RESEARCH_AI_QUEUE_MAX=20
RESEARCH_AI_TIMEOUT_SECONDS=600

# --- coding agent (docs/05-agents.md, "Coding agent"). Admin-only; never merges or deploys. ---
# Host folder holding the checkouts below (mounted into coding-worker at the same path).
CODE_REPOS_ROOT=/opt/private-ai/repos
# JSON, one line. Only these repos are readable; tests must be in CODE_ALLOWED_COMMANDS.
# CODE_REPOS={"astra-frontend":{"path":"/opt/private-ai/repos/astra-frontend","base":"dev01","tests":[["npm","test"]],"link":["node_modules"]},"aureon-agentic":{"path":"/opt/private-ai/repos/aureon","base":"main","tests":[[".venv/bin/python","-m","pytest","-q","-m","not db"]],"link":[".venv"]},"aureon-mt5-bot":{"path":"/opt/private-ai/repos/aureon_agentic_bot","base":"master","tests":[],"link":[]}}
CODE_REPOS=
# Exact argv lists the agent may run; empty = the built-in list (npm test, pytest -q, ruff ...).
CODE_ALLOWED_COMMANDS=
CODE_PROTECTED_BRANCHES=main,master,dev01,dev,develop,production
CODE_WORKTREE_ROOT=/mnt/spasta-data/code-worktrees
# Local Ollama coding model, e.g. qwen2.5-coder:7b (empty = coding tasks fail "not configured").
CODE_MODEL=
CODE_MODEL_TIMEOUT_SECONDS=900
CODE_TEST_TIMEOUT_SECONDS=900
# Git ops (docs/05-agents.md, "Git ops"): the coding worker may clone / pull these GitHub repos
# and push FEATURE branches to them + open a PR. JSON list of owner/repo; empty = none. Each
# must also pass GITHUB_ALLOWED_OWNERS / GITHUB_ALLOWED_REPOS. Uses GITHUB_TOKEN (needs
# contents:write + pull_requests:write on these repos), passed to git only via GIT_ASKPASS.
GITHUB_CODING_REPO_ALLOWLIST=[]
# Clones live here (on the HDD, same volume as the worktrees): <root>/<owner>/<repo>.
CODE_CLONE_ROOT=/mnt/spasta-data/code-worktrees/repos
# A push is refused unless the branch starts with one of these. main, master, dev01, the
# repo's default branch, CODE_PROTECTED_BRANCHES and GitHub-protected branches never push.
CODE_PUSH_BRANCH_PREFIXES=aureon/,feat/
GITHUB_GIT_URL=https://github.com
CODE_GIT_TIMEOUT_SECONDS=600

# --- paper trading (docs/15-paper-trading.md). Simulated fills only; never a broker order. ---
PAPER_STARTING_CAPITAL=1000000
PAPER_PRICE_MAX_AGE_SECONDS=180
# JSON, one line. Spread and slippage per broker, in bps.
PAPER_COSTS={"dhan":{"spread_bps":"2","slippage_bps":"1"},"mt5":{"spread_bps":"1","slippage_bps":"1"}}
# JSON overrides of the Indian charge schedule (top-level keys replace; see the doc).
PAPER_DHAN_CHARGES=
PAPER_MT5_COMMISSION_PER_LOT=0

# --- frontend real-time stream (docs/14-frontend.md) ---
TRADING_STREAM_POLL_SECONDS=2
TRADING_STREAM_HEARTBEAT_SECONDS=15
TRADING_STREAM_MAX_SECONDS=1800

# --- frontend support (docs/02-auth-and-finance.md#frontend-support) ---
# Receipt attachments under DATA_ROOT/finance-attachments (PNG/JPEG/WebP/PDF, sniffed).
FINANCE_ATTACHMENT_MAX_BYTES=10485760
FINANCE_ATTACHMENTS_MAX_PER_USER=2000
FINANCE_TOMBSTONE_RETENTION_DAYS=30
FINANCE_CHANGES_MAX_ROWS=5000
# GET /api/public/* per client IP per minute.
PUBLIC_RATE_LIMIT_PER_MINUTE=60
# JSON list of RSS/Atom URLs for the news_pull job; empty = job off (no outbound calls).
NEWS_FEED_URLS=
NEWS_PULL_CRON=*/30 * * * *
NEWS_HTTP_TIMEOUT=10
NEWS_MAX_ITEMS=200
NEWS_MAX_FEED_BYTES=2097152

# --- GitHub (docs/18-github-foundation.md, PAT steps in docs/manual-setup.md) ---
# Fine-grained PAT, server .env only (never VITE_*, never in Git). Empty = integration off.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# JSON lists. Owners empty = only the token user's own repos. Repos set = that exact list.
GITHUB_ALLOWED_OWNERS=[]
GITHUB_ALLOWED_REPOS=[]
GITHUB_CACHE_TTL_SECONDS=60
GITHUB_CONNECT_TIMEOUT=5
GITHUB_READ_TIMEOUT=20
GITHUB_MAX_ATTEMPTS=3
GITHUB_RETRY_BACKOFF_SECONDS=0.5
GITHUB_MAX_RETRY_WAIT_SECONDS=20
GITHUB_RATE_LIMIT_FLOOR=50
GITHUB_MAX_PAGES=10
GITHUB_MAX_FILE_BYTES=524288
GITHUB_MAX_TREE_ENTRIES=5000
GITHUB_SYNC_CRON=*/20 * * * *
GITHUB_AGENT_STALE_SECONDS=3600
# Issues + PRs (docs/19-github-issues-prs.md): largest unified diff returned (bytes).
GITHUB_DIFF_MAX_BYTES=2097152

# --- GitHub Actions + webhooks (docs/20-github-actions-webhooks.md) ---
# Logs: sanitised text, tail-first, at most this many bytes per response.
GITHUB_LOG_MAX_BYTES=1048576
GITHUB_LOG_DOWNLOAD_MAX_BYTES=33554432
GITHUB_LOG_UNZIP_MAX_BYTES=67108864
GITHUB_LOG_ZIP_MAX_ENTRIES=500
# Hosts a log redirect may point at (label-wise wildcards, https only). Logs only.
GITHUB_LOG_HOSTS=["pipelines.actions.githubusercontent.com","*.actions.githubusercontent.com","productionresultssa*.blob.core.windows.net"]
# JSON list of "owner/repo:workflow_file" that may be dispatched / re-run. Empty = none.
GITHUB_DISPATCH_ALLOWLIST=[]
# Workflow names / files that deploy to prod (gated by an approval). Names or files
# containing "deploy" or "prod" are always treated as production too.
GITHUB_PROD_WORKFLOWS=[]
# Webhook secret (openssl rand -hex 32). Unset = POST /api/v1/github/webhooks answers 503.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_MAX_BYTES=1048576
GITHUB_WEBHOOK_STORE_MAX_BYTES=262144
GITHUB_WEBHOOK_MAX_ATTEMPTS=5
GITHUB_WEBHOOK_RETRY_BASE_SECONDS=5
GITHUB_WEBHOOK_POLL_SECONDS=5
GITHUB_ACTIONS_SYNC_CRON=*/15 * * * *
GITHUB_ACTIONS_SYNC_RUNS=30
# Actions monitor: the repo@branch each host deploy target builds (JSON, one line).
DEPLOY_TARGET_REPOS={"backend":"SVSKHD/Aureon_agents_Assembler@main","frontend":"SVSKHD/ASTRA-FRONTEND@dev01"}

# --- Approval gate (docs/19-github-issues-prs.md) ---
# Merge, force-push, branch protection, branch delete and repo settings need an approved
# request (admin password re-entered). Pending requests expire after this many minutes.
APPROVALS_TTL_MINUTES=30
# true: the requester may approve their own request only while they are the only admin.
APPROVALS_ALLOW_SELF_APPROVAL=true
# Wrong re-auth passwords before a request is denied automatically.
APPROVALS_MAX_REAUTH_FAILURES=5

# --- Incidents + self-repair (docs/21-self-repair.md) ---
# Local Ollama model for repair patches (pull it first, see docs/manual-setup.md).
# Empty = repairs disabled: incidents are still detected and recovered; repair tasks stay
# queued with the reason. Suggested: qwen2.5-coder:7b
REPAIR_MODEL=
# The CODE_REPOS entry repairs run in, and its GitHub owner/repo (also in the GitHub allowlist).
REPAIR_REPO=
REPAIR_GITHUB_REPO=
REPAIR_MODEL_TIMEOUT_SECONDS=900
REPAIR_POLL_SECONDS=10
REPAIR_QUEUE_MAX=5
REPAIR_MAX_PER_FINGERPRINT_PER_DAY=2
# More failed repairs than this in an hour pauses the `repair` agent (resume it by hand).
REPAIR_BREAKER_MAX_FAILURES_PER_HOUR=3
REPAIR_TEST_OUTPUT_MAX_CHARS=32000
INCIDENT_MAX_RECOVERY_ATTEMPTS=2
INCIDENT_RECOVERY_COOLDOWN_SECONDS=120
INCIDENT_EXCEPTION_RATE_SECONDS=60
INCIDENT_SCAN_CRON=* * * * *
INCIDENT_DB_SLOW_MS=1000
INCIDENT_API_READY_URL=http://aureon-api:8000/api/health/ready
INCIDENT_DOCKER_PROBE_SECONDS=60
# The shipped docker-proxy is read-only (POST: "0"), so container restarts are "manual".
INCIDENT_DOCKER_PROXY_ALLOWS_RESTART=false
INCIDENT_RESTART_CONTAINERS=

# --- Approval engine (docs/23-approval-engine.md) ---
# Policies (required approvals, expiry, self-approval, re-auth) are rows in
# audit.approval_policies, edited with PUT /api/v1/approvals/policies.
# Cap for a session re-auth stamp (seconds); 0 disables POST /api/v1/approvals/reauth.
APPROVALS_REAUTH_STAMP_MAX_SECONDS=900
APPROVALS_ARTIFACT_MAX_CHARS=65536
APPROVALS_EXPIRE_CRON=* * * * *
APPROVALS_STREAM_POLL_SECONDS=2
APPROVALS_STREAM_HEARTBEAT_SECONDS=15
APPROVALS_STREAM_MAX_SECONDS=1800
# Deep links in notifications point here: ${PUBLIC_APP_URL}/dev/approvals/{id}
PUBLIC_APP_URL=https://spasta.online
# Discord incoming webhook URL (a secret: never commit it). Empty = no notifications.
# Notifications carry kind, target and summary only, and link to the app; nothing can be
# approved from Discord.
DISCORD_WEBHOOK_URL=
DISCORD_MAX_ATTEMPTS=3
DISCORD_REQUEST_SECONDS=5
DISCORD_RETRY_BASE_SECONDS=1
# Voice navigation: optional local Ollama model for utterances the grammar does not match.
VOICE_OLLAMA_MODEL=

# --- Claude review (docs/22-claude-review.md) ---
# The only non-Ollama AI path: the local Claude CLI reviews a PR on request (advisory only;
# published as a COMMENT review, never an approval). Off unless true.
CLAUDE_REVIEW_ENABLED=false
# A name on PATH or an absolute path.
CLAUDE_CLI_PATH=claude
# JSON argv after the binary; the prompt always goes on stdin.
CLAUDE_CLI_ARGS=["-p","--output-format","json","--no-session-persistence","--strict-mcp-config","--tools",""]
# Comma list of env var NAMES passed to the CLI for its auth (e.g. CLAUDE_CODE_OAUTH_TOKEN).
# Repo secrets (GITHUB_*, DATABASE_*, SECRET*, REDIS*, ...) are always refused.
CLAUDE_CLI_ENV_PASSTHROUGH=
CLAUDE_REVIEW_TIMEOUT_SECONDS=300
# Larger diffs are never sent (REVIEW_UNAVAILABLE too_large).
CLAUDE_REVIEW_MAX_DIFF_BYTES=204800
CLAUDE_REVIEW_MAX_QUEUE=5
# Host names under these domains are masked before sending.
CLAUDE_REVIEW_INTERNAL_DOMAINS=spasta.online

# --- Production integration (docs/24-production-integration.md) ---
# Discord alerts (needs DISCORD_WEBHOOK_URL): incidents >= warning, stale heartbeats, backup
# problems, approvals about to expire. Empty cron = no job.
ALERTS_CRON=*/5 * * * *
ALERTS_DEDUP_MINUTES=60
ALERTS_MAX_PER_RUN=10
ALERTS_APPROVAL_EXPIRY_MINUTES=10
# Written by scripts/ops/backup.sh; the scheduler reads it from its read-only HDD mount.
BACKUP_STATUS_FILE=/mnt/spasta-data/ops-status/backup.json
BACKUP_MAX_AGE_HOURS=26
# Optional app-level Cloudflare Access JWT check (both or neither; off when empty).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_CERTS_TTL_SECONDS=3600
CF_ACCESS_LEEWAY_SECONDS=30
CF_ACCESS_BYPASS_PATHS=/api/v1/github/webhooks,/api/public/,/api/health

# --- compose-only ---
# Name of the existing Docker network shared by Postgres + Ollama (docker network ls).
PRIVATE_AI_NETWORK=<private-ai-network>
IMAGE_TAG=dev
