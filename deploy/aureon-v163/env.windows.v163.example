# ======== Aureon V1.6.3 Windows MT5 box -> Assembler (docs/34-aureon-v163.md) ========
# Collector + guard only. NO database credentials and NO admin token on this machine.
STORE_MODE=api
# HTTPS is required off-localhost (the V1.6.3 client refuses plain HTTP and never follows a
# redirect with the token). Use the Tailscale HTTPS name the MT5 push already uses; the
# client appends api/v1/ingest/... itself, so no path here.
ASSEMBLER_API_URL=https://svskhd8.taila439d5.ts.net
# The SAME values as AUREON_API_COLLECTOR_TOKEN / AUREON_API_GUARD_TOKEN on the Assembler.
# The collector process uses the collector token, the guard process (AUREON_SERVICE=guard)
# the guard token. Leave ASSEMBLER_API_SVC_TOKEN empty when both are set.
ASSEMBLER_API_COLLECTOR_TOKEN=
ASSEMBLER_API_GUARD_TOKEN=
ASSEMBLER_API_SVC_TOKEN=
ASSEMBLER_API_TIMEOUT=15
SYMBOL=XAUUSD
WEEKLY_OPEN_RULE=us_dst
WEEKLY_OPEN_MIN_FRACTION=0.75
# From scripts/diagnose_timestamps.py on THIS broker: 'utc' | 'server_offset:+N' | 'server_dst:eu:+2'
MT5_TIME_POLICY=
MT5_PAPER=true
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MAX_LOSS_PER_DAY_USD=60
COUNT_FLOATING_IN_DAILY_LOSS=true
FLATTEN_ON_LOCK=true
NAKED_POSITION_POLICY=flatten_after
NAKED_POSITION_GRACE_MIN=5
SESSION_FIRST_BAR_UTC=01:00
# Optional: the guard enqueues alerts through the Assembler (POST /api/v1/ingest/alert);
# a direct webhook is only used by V1.6.3 code paths that post themselves.
DISCORD_WEBHOOK_URL=
