# Cloudflare Access for spasta.online + api.spasta.online (docs/24, Phase 22).
# Terraform-style reference (cloudflare provider 4.x resource names). It is NOT applied by
# anything in this repo; deploy/cloudflare/README.md has the same setup as dashboard steps.
#
#   terraform init && terraform plan -var account_id=... -var owner_email=...
#
# Precedence: Cloudflare matches the MOST SPECIFIC application path first, so the bypass
# applications below win over the two hostname-wide applications for exactly their paths.

variable "account_id" { type = string }
variable "owner_email" { type = string }       # the only human allowed in
variable "session_duration" {
  type    = string
  default = "24h"                              # re-login once a day
}

# --- the two protected applications --------------------------------------------------------

resource "cloudflare_access_application" "web" {
  account_id                = var.account_id
  name                      = "Spasta web"
  domain                    = "spasta.online"
  type                      = "self_hosted"
  session_duration          = var.session_duration
  app_launcher_visible      = false
  auto_redirect_to_identity = true
  http_only_cookie_attribute = true
  same_site_cookie_attribute = "strict"
  enable_binding_cookie      = true
}

resource "cloudflare_access_application" "api" {
  account_id                 = var.account_id
  name                       = "Spasta API"
  domain                     = "api.spasta.online"
  type                       = "self_hosted"
  session_duration           = var.session_duration
  app_launcher_visible       = false
  http_only_cookie_attribute = true
  same_site_cookie_attribute = "strict"
  enable_binding_cookie      = true
}

resource "cloudflare_access_policy" "web_owner" {
  account_id     = var.account_id
  application_id = cloudflare_access_application.web.id
  name           = "Owner only"
  precedence     = 1
  decision       = "allow"
  include { email = [var.owner_email] }
}

resource "cloudflare_access_policy" "api_owner" {
  account_id     = var.account_id
  application_id = cloudflare_access_application.api.id
  name           = "Owner only"
  precedence     = 1
  decision       = "allow"
  include { email = [var.owner_email] }
}

# Machine access (scripts/ops/acceptance.py run from off the box, uptime checks): a service
# token, sent as CF-Access-Client-Id / CF-Access-Client-Secret. Non-identity decision.
resource "cloudflare_access_service_token" "ops" {
  account_id = var.account_id
  name       = "aureon-ops"
  duration   = "8760h"
}

resource "cloudflare_access_policy" "api_service_token" {
  account_id     = var.account_id
  application_id = cloudflare_access_application.api.id
  name           = "Ops service token"
  precedence     = 2
  decision       = "non_identity"
  include { service_token = [cloudflare_access_service_token.ops.id] }
}

# --- bypass ONLY these paths ---------------------------------------------------------------
# GitHub cannot send Access headers; the receiver verifies X-Hub-Signature-256 (HMAC) and is
# idempotent on X-GitHub-Delivery.
resource "cloudflare_access_application" "api_github_webhooks" {
  account_id       = var.account_id
  name             = "Spasta API: GitHub webhooks (bypass)"
  domain           = "api.spasta.online/api/v1/github/webhooks"
  type             = "self_hosted"
  session_duration = "0s"
}

resource "cloudflare_access_policy" "api_github_webhooks_bypass" {
  account_id     = var.account_id
  application_id = cloudflare_access_application.api_github_webhooks.id
  name           = "Bypass (HMAC-verified in the app)"
  precedence     = 1
  decision       = "bypass"
  include { everyone = true }
}

# Public, rate-limited, read-only: shared documents and the forex news list.
resource "cloudflare_access_application" "public_api" {
  for_each         = toset(["spasta.online/api/public", "api.spasta.online/api/public"])
  account_id       = var.account_id
  name             = "Spasta public API (bypass): ${each.value}"
  domain           = each.value
  type             = "self_hosted"
  session_duration = "0s"
}

resource "cloudflare_access_policy" "public_api_bypass" {
  for_each       = cloudflare_access_application.public_api
  account_id     = var.account_id
  application_id = each.value.id
  name           = "Bypass (public endpoints)"
  precedence     = 1
  decision       = "bypass"
  include { everyone = true }
}

output "aud_web" { value = cloudflare_access_application.web.aud }
output "aud_api" { value = cloudflare_access_application.api.aud }
output "ops_token_client_id" { value = cloudflare_access_service_token.ops.client_id }
